<header>
    <div class="header-left">
        <a href="/"><img src="/images/Logo.png" alt="Big Books Logo" class="logo"></a>
    </div>
    <div class="header-center">
        <form action="/books" method="GET">
            <input type="text" name="search" placeholder="Search..." class="search-bar" value="<%= searchTerm || '' %>">
            <button type="submit" style="display: none;"></button>
        </form>
    </div>
    <div class="header-right">
        <nav>
            <ul class="nav-links">
                <li><a href="/books">Browse</a></li>
                <li><a href="/books/new">Sell</a></li>
                <% if (!user) { %>
                    <li><a href="/users/login">Login</a></li>
                    <li><a href="/users/newU">Sign Up</a></li>
                <% } else { %>
                    <li><a href="/users/profile">Profile</a></li>
                    <li><a href="/users/logout">Logout</a></li>
                <% } %>
            </ul>
        </nav>
    </div>
</header>

<div class="flash-messages">
    <% if (errorMessages && errorMessages.length > 0) { %>
        <% errorMessages.forEach(message => { %>
            <div class="flash-message error"><%= message %></div>
        <% }) %>
    <% } %>

    <% if (successMessages && successMessages.length > 0) { %>
        <% successMessages.forEach(message => { %>
            <div class="flash-message success"><%= message %></div>
        <% }) %>
    <% } %>
</div>
